# Control plane — see docs/self-hosting.md
DATABASE_URL=postgres://localhost:5432/fleetos_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
SECRETS_MASTER_KEY=            # 32 bytes, base64. Generate: openssl rand -base64 32
HEARTBEAT_INTERVAL_SEC=5
HEARTBEAT_MISS_THRESHOLD=3
REGISTRY_URL=              # e.g. localhost:5001 or ghcr.io/you
REGISTRY_CREDENTIALS=      # push/pull auth, if the registry needs it
BUILDX_BUILDER=            # named buildx builder; blank uses the default
# Which builder serves which platform. Blank means one builder for everything,
# with QEMU for whatever it cannot do natively — which is what makes an arm64
# image on an amd64 control plane take tens of minutes. See
# deploy/setup-arm64-builder.sh.
#   BUILDX_PLATFORM_BUILDERS=linux/arm64=fleet-builder,linux/amd64=fleet-builder
BUILDX_PLATFORM_BUILDERS=
BUILD_WORKDIR=/tmp/fleet-os/builds
BUILD_TIMEOUT_MS=1200000
# GitHub App — App ID and Client ID are public; the private key is not.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# From https://github.com/apps/<slug>; required to start the install flow.
GITHUB_APP_SLUG=
# Where GitHub returns the browser after an install completes.
PUBLIC_DASHBOARD_URL=

PORT=8080
INGRESS_PORT=8081          # public edge; separate listener from the API
INGRESS_ENABLED=true
INGRESS_ZONE=fleetos.app    # managed hostnames: <service>.<fleet>.<zone>
LOG_LEVEL=info
