# Public browser configuration; never put credentials here.
VITE_APP_URL=https://fleetapp.plastikworld.xyz
# Optional independent public status snapshot; must allow browser GET requests.
VITE_STATUS_SNAPSHOT_URL=
# Public status API origin; never include canary or ingest credentials here.
VITE_FLEET_API_URL=https://fleetapi.plastikworld.xyz
# Set SITE_ORIGIN in the build process environment (not a VITE secret).
# SITE_ORIGIN=https://fleet.plastikworld.xyz npm run build
